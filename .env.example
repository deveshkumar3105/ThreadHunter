# ThreadHunter Configuration

# Host and Port
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Google Gemini API Key(s) (Free tier keys from Google AI Studio)
# You can supply a single key or multiple comma-separated keys for automatic key rotation on 429 quota limits:
# GEMINI_API_KEYS=AIzaSyD...,AIzaSyE...
GEMINI_API_KEYS=

# Optional single key fallback
GEMINI_API_KEY=
